{
  "name": "@arcade-cabinet/jeep-sqlite",
  "version": "2.8.0-arcade.2",
  "description": "Private current-upstream build of jeep-sqlite 2.8.0 for Arcade Cabinet browser SQLite consumers",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "types": "./dist/types/components.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/jeep-sqlite/jeep-sqlite.esm.js",
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "copy:sql:wasm": "node scripts/copy-wasm.mjs",
    "build": "npm run copy:sql:wasm && stencil build --docs && npm run verify:dist",
    "prepack": "npm run build",
    "start": "npm run copy:sql:wasm && stencil build --dev --watch --serve",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test.watch": "vitest",
    "verify:dist": "node scripts/verify-browser-dist.mjs",
    "generate": "stencil generate",
    "verify:currency": "npm outdated --omit=dev",
    "verify:security": "npm audit --omit=dev --audit-level=high"
  },
  "dependencies": {
    "@stencil/core": "4.43.5",
    "browser-fs-access": "0.38.0",
    "jszip": "3.10.1",
    "localforage": "1.10.0",
    "sql.js": "1.14.2"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/sql.js": "1.4.11",
    "@stencil/vitest": "1.14.0",
    "rollup-plugin-node-polyfills": "0.2.1",
    "vitest": "4.1.10"
  },
  "keywords": [
    "SQLite",
    "SQLite in Browser",
    "stencil",
    "web component"
  ],
  "author": "Jean Pierre Quéau",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jbcom/jeep-sqlite.git"
  },
  "bugs": {
    "url": "https://github.com/jepiqueau/jeep-sqlite.git/issues"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://registry.npmjs.org/"
  }
}
